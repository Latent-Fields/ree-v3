# Worker overrides for /etc/systemd/system/ree-runner.service.d/shadow.conf
# on cloud-2 / cloud-3 / cloud-4 (NOT the hub -- use shadow.conf.hub.example
# for ree-cloud-1 / ree-worker-1).
#
# Architecture:
#   - Runners POST heartbeats/status/results/claims to the coordinator (always;
#     this is the Phase 3 transport).
#   - sync_daemon.phase3_heartbeat_writer on the hub is the SOLE git publisher
#     for evidence/experiments/runner_heartbeats/*.json + runner_status/*.json.
#   - Workers must NOT write those telemetry files into their own REE_assembly
#     checkout: the local write conflicts with the hub-materialised version on
#     `git pull --rebase --autostash` and accumulates dormant autostashes
#     (cloud-3 hit 43 on 2026-06-02; 191 by 2026-05-31).
#
# PHASE3_RUNNER_TELEMETRY_OFF_GIT is the worker-safe gate for this. It suppresses
# ONLY the heartbeat + status FILE writes; it does NOT touch the command-file
# read/write path, so stop-command persistence is preserved and there is no
# restart loop. This is the key difference from PHASE3_DISABLE_RUNNER_HEARTBEAT_WRITE,
# which is hub-only -- setting that on a worker also gates the command-file
# writeback and restart-loops the unit (incident 2026-05-30). Do NOT set
# _HEARTBEAT_WRITE on a worker; the runtime self-guard refuses it anyway.

[Service]
Environment=COORDINATION_MODE=coordinator
Environment=COORDINATOR_URL=http://10.8.0.1:8787
Environment=COORDINATOR_TOKEN=<paste from coordinator.env>
# Shadow-mode client log. Live on cloud-2/3/4 and declared in the hub template
# since the isolated-checkout cutover; it was simply never recorded here
# (systemd_dropin_drift.py reported it EXTRA on all three workers 2026-07-30).
Environment=COORDINATOR_LOG=/home/ree/coordinator_shadow.log

# Phase 3: runner does not git-push results / queue / heartbeats (hub sync_daemon owns those).
Environment=PHASE3_DISABLE_RUNNER_RESULT_PUSH=1
Environment=PHASE3_DISABLE_RUNNER_QUEUE_PUSH=1
Environment=PHASE3_DISABLE_RUNNER_HEARTBEAT_PUSH=1

# Claim-push gate (2026-06-03): retire the last git-as-IPC coordination path.
# The coordinator /claim endpoint (db.try_claim, atomic BEGIN IMMEDIATE) is the
# authoritative claim mutex under COORDINATION_MODE=coordinator, so the legacy
# attempt_claim / release_claim `claim:` commits to ree-v3/main are pure noise.
# The claimed_by write still lands in the LOCAL queue file (read next tick);
# only the commit/push is skipped. Default OFF = bit-identical git-mode mutex;
# safe to set whenever COORDINATION_MODE=coordinator (set above). NOTE: the
# legacy QUEUE_PUSH=1 above already suppressed this push via _claim_push_gated;
# the dedicated flag makes the intent explicit and survives a QUEUE_PUSH=0 flip.
Environment=PHASE3_DISABLE_RUNNER_CLAIM_PUSH=1

# Worker-safe telemetry-off-git gate (2026-06-02): stop the per-tick
# runner_heartbeats/<host>.json + runner_status/<host>.json FILE writes from
# dirtying the shared checkout. Coordinator POST stays the transport; the hub
# writer materialises git. Does NOT gate the command channel -- no restart loop.
Environment=PHASE3_RUNNER_TELEMETRY_OFF_GIT=1

# Side-file sync (2026-06-10): ship a run's COMPANION artifacts (e.g. an
# *_episode_log.json that fishtank_viz.html reads) to the coordinator after the
# manifest POST, so a fishtank showcase that runs here lands its episode_log on
# origin instead of stranding it on this worker's disk (V3-EXQ-664 incident).
# Default OFF = bit-identical (no companion POSTs). Enable together with the hub
# writer's PHASE3_SPOOL_SIDEFILES (shadow.conf.hub.example); the worker just
# spools, the hub writer commits. Companions are read-only side data, so this is
# safe on any worker.
#
# ROLLOUT COMPLETE (recorded 2026-07-30). Live on cloud-1/2/3/4. Note it is
# currently delivered by a SEPARATE `sidefiles.conf` drop-in rather than this
# file -- systemd merges every *.conf in the .d directory, so the effective
# config is the same and it is declared here as part of the worker baseline.
Environment=PHASE3_SPOOL_SIDEFILES=1

# Clean drain (exit 0) from a queued stop should respawn with latest disk bytes.
Restart=always

# --- Command-channel coordinator migration (2026-06-02) -------------------
# ROLLOUT COMPLETE (recorded 2026-07-30). Both steps below are live on
# cloud-1/2/3/4; the coordinator is the SOLE command channel and the git
# command-file path is no longer in use. They are recorded here as ACTIVE
# baseline directives rather than as staged instructions, because a flag that
# is live on every machine while the template still describes it as a
# not-yet-started canary is exactly the drift systemd_dropin_drift.py exists to
# catch (it reported both as UNDECLARED on 2026-07-30, on all four boxes).
#
# The original staging is preserved for the record: enable per-worker, cloud-2
# (idle) FIRST as the canary; verify stop/pause/resume/release_claim round-trip
# via the coordinator AND no systemd restart loop BEFORE touching cloud-3/4.
# serve.py must also have PHASE3_COMMANDS_DUAL_WRITE=1 set (after this flag) so
# issued commands reach the coordinator channel. Re-follow that order if these
# are ever rolled back and re-enabled.
#
# Step 1: dual-read -- fetch+ack via coordinator AND git file.
Environment=PHASE3_COMMANDS_VIA_COORDINATOR=1
#
# Step 2: coordinator is the SOLE channel. Implies VIA_COORDINATOR;
# self-guards back to git if the coordinator is unreachable.
Environment=PHASE3_COMMANDS_OFF_GIT=1

# ExecStart must include: --machine ree-cloud-2  (or -3 / -4 as appropriate)
#
# PHASE3_DISABLE_RUNNER_HEARTBEAT_WRITE is PERMITTED but NOT SET on any worker,
# and this is not an instruction to add it. Its precondition is now satisfied
# everywhere (PHASE3_COMMANDS_OFF_GIT=1 above removes the command-file
# restart-loop hazard that made _HEARTBEAT_WRITE hub-only -- acks persist in the
# coordinator). PHASE3_RUNNER_TELEMETRY_OFF_GIT already suppresses the telemetry
# file writes on workers, so there is nothing left for it to buy here. Left
# unset deliberately: setting it would be a live-config change with no benefit,
# and the 2026-05-30 restart-loop incident came from setting it when its
# precondition did NOT hold.
