# REE metaworker-dispatch -- systemd unit template (Phase H cloud-metaworker box)
#
# Reference copy, synced by hand from the live file on ree-worker-5
# (/etc/systemd/system/ree-metaworker.service) -- same convention as
# ree-runner.service in this repo (see cloud_workers.md's note on that file).
# This box is NOT an experiment runner: it runs one dispatch cycle of
# .claude/skills/metaworker-dispatch/SKILL.md per invocation, paced externally
# by ree-metaworker.timer (5-minute OnUnitActiveSec) rather than a persistent
# `/loop` session -- see the Phase H runbook (WORKSPACE_STATE.md, 2026-08-02/03)
# for why a stateless relaunch was chosen over a long-lived ScheduleWakeup loop.
#
# Installation (on the cloud VM, as the `ree` user with sudo):
#   sudo cp ree-metaworker.service ree-metaworker.timer /etc/systemd/system/
#   sudo cp ree-metaworker-dispatch.sh /usr/local/bin/ree_metaworker_dispatch.sh
#   sudo chmod 755 /usr/local/bin/ree_metaworker_dispatch.sh
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ree-metaworker.timer
#
# Logs: journalctl -u ree-metaworker -f   |   ~/ree_metaworker_dispatch.log

[Unit]
Description=REE metaworker-dispatch: one dispatch cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ree
WorkingDirectory=/home/ree/REE_Working
ExecStart=/usr/local/bin/ree_metaworker_dispatch.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ree-metaworker
# TimeoutStartSec raised 280 -> 1800 on 2026-08-09
# (chip-20260809-metaworker-cycles-overlap). At 280s any cycle running longer than
# 4m40s had its bash wrapper SIGTERMed while the `claude -p` child survived
# (KillMode=process, below), so the next timer tick started a fresh instance that
# overlapped the surviving orphan -- confirmed live 2026-08-09T11:32Z with THREE
# dispatchers alive at once. Real dispatch cycles legitimately run ~12min when they
# do coordination-data repair, so 280s was below the normal ceiling. 1800s keeps a
# normal long cycle inside the service lifetime, so the unit stays active for its
# whole run and systemd's own one-instance-per-oneshot-unit guarantee prevents the
# overlap. The wrapper's `flock`+`timeout` (in ree_metaworker_dispatch.sh) is the
# duration-independent backstop and the hard bound on a genuinely hung claude
# (REE_DISPATCH_MAX_SEC, default 1500s); this 1800s > that bound + wrapper overhead.
TimeoutStartSec=1800
# Dispatched workers are descendants of ExecStart. Under the default
# KillMode=control-group systemd SIGTERMs the whole cgroup when this oneshot
# deactivates, killing every worker ~1-2min after dispatch (100% mortality,
# transcripts ending in "[Request interrupted by user]"). Kill only the
# dispatcher; workers are reaped by metaworker_worktree_gc / the chip ledger.
KillMode=process
